<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Add internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon_budget_master_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon_budget_master_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.BudgetMaster">

        <!-- Splash Activity as Main Launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BudgetMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sign Up Activity -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false" />

        <!-- Sign In Activity -->
        <activity
            android:name=".SignInActivity"
            android:exported="false" />

        <!-- Dashboard Activity -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Add Transaction Activity -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false" />

        <!-- Investments Activity -->
        <activity
            android:name=".InvestmentsActivity"
            android:exported="false" />

        <!-- Goals Activity -->
        <activity
            android:name=".GoalsActivity"
            android:exported="false" />

        <!-- Add Goal Activity -->
        <activity
            android:name=".AddGoalActivity"
            android:exported="false" />

        <!-- Statistics Activity -->
        <activity
            android:name=".StatisticsActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

    </application>

</manifest>