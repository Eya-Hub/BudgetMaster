<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_budget_master_logo"
            android:contentDescription="@string/app_logo" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="BudgetMaster"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:gravity="center" />

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="profile"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <TextView
                android:id="@+id/tv_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Add Transaction"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="#0B5563"
                android:gravity="center" />

            <!-- INPUT BLOCK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blockLightGreen"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <!-- AMOUNT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_amount"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@color/inputWhite"
                    android:inputType="numberDecimal"
                    android:hint="Enter amount"
                    android:padding="10dp"
                    android:layout_marginTop="6dp" />

                <!-- CATEGORY -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:paddingTop="12dp"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <AutoCompleteTextView
                    android:id="@+id/et_category"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Choose category"
                    android:padding="10dp"
                    android:background="@color/inputWhite"
                    android:layout_marginTop="6dp"
                    android:completionThreshold="1"
                    android:inputType="text" />

                <!-- DATE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:paddingTop="12dp"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_date"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@color/inputWhite"
                    android:hint="YYYY-MM-DD"
                    android:focusable="false"
                    android:padding="10dp"
                    android:layout_marginTop="6dp" />

                <!-- LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Label"
                    android:paddingTop="12dp"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <AutoCompleteTextView
                    android:id="@+id/et_label"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@color/inputWhite"
                    android:hint="Choose or type label"
                    android:padding="10dp"
                    android:layout_marginTop="6dp"
                    android:completionThreshold="1"
                    android:inputType="text" />

                <!-- DESCRIPTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:paddingTop="12dp"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@color/inputWhite"
                    android:hint="Enter description (optional)"
                    android:padding="10dp"
                    android:layout_marginTop="6dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />

                <!-- ADD BUTTON -->
                <Button
                    android:id="@+id/btn_add"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="ADD"
                    android:textColor="@color/white"
                    android:background="@color/buttonGreen"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- TOTAL SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/blockLightGreen"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_total_income"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Income: 0.0 DT"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_total_outcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Outcome: 0.0 DT"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Balance: 0.0 DT"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#008B8B"
        android:paddingVertical="12dp"
        android:elevation="8dp">

        <!-- Investment Tab -->
        <LinearLayout
            android:id="@+id/btnInvestment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivInvestment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_upload"
                android:contentDescription="investment"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvInvestment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Investments"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Goals Tab -->
        <LinearLayout
            android:id="@+id/btnGoals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivGoals"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:contentDescription="goals"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvGoals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goals"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Statistics Tab -->
        <LinearLayout
            android:id="@+id/btnStatistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivStatistics"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="statistics"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvStatistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stats"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>